---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-couleurs-du-bien-etre.webp";
import { NAV_LINKS, SITE } from "../data/site";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 bg-white shadow-[0_1px_4px_rgba(0,0,0,0.12)]">
  <div class="mx-auto flex h-[77px] max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <Image src={logo} alt="Logo Les couleurs du bien-être par Sarah Vidal" width={88} height={88} class="h-11 w-11" />
      <span class="hidden flex-col leading-tight sm:flex lg:hidden xl:flex">
        <span class="font-body text-xs font-extrabold tracking-wide text-heading uppercase">
          {SITE.name}
        </span>
        <span class="font-script text-lg text-heading">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      {NAV_LINKS.map((link) => (
        <div class="group relative">
          <a
            href={link.href}
            class:list={[
              "font-body inline-block rounded-md px-3 py-2 text-sm font-extrabold tracking-wide whitespace-nowrap uppercase transition-colors",
              isActive(link.href) ? "text-primary" : "text-nav hover:text-primary",
            ]}
          >
            {link.label}
          </a>
          {link.children && (
            <div
              class="invisible absolute left-0 top-full flex min-w-[220px] flex-col gap-1 rounded-xl border border-bg-gray/60 bg-white p-2 opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
            >
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="font-body rounded-lg px-3 py-2 text-sm font-semibold text-nav transition-colors hover:bg-bg-cream hover:text-primary"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/contact"
        class="font-body inline-flex items-center rounded-full bg-primary px-5 py-2.5 text-sm font-bold tracking-wide whitespace-nowrap text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
      >
        Me contacter
      </a>
      <button
        type="button"
        class="menu-toggle flex h-11 w-11 items-center justify-center rounded-full text-heading transition-colors hover:bg-bg-cream lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="menu-backdrop lg:hidden" aria-hidden="true"></div>

  <nav id="menu-mobile" class="menu-panel lg:hidden" aria-label="Navigation mobile" inert>
    <ul class="mx-auto flex max-w-6xl flex-col px-6 py-6">
      {NAV_LINKS.map((link, index) => (
        <li class="menu-item border-b border-bg-cream last:border-none" style={`--i: ${index}`}>
          <a
            href={link.href}
            class:list={[
              "font-display block py-3 text-3xl font-bold transition-colors",
              isActive(link.href) ? "text-primary" : "text-heading hover:text-primary",
            ]}
          >
            {link.label}
          </a>
          {link.children && (
            <ul class="flex flex-col pb-3 pl-4">
              {link.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class:list={[
                      "font-body block py-1.5 text-sm font-semibold transition-colors",
                      isActive(child.href) ? "text-primary" : "text-nav hover:text-primary",
                    ]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Menu mobile : tout est piloté par [data-menu-open] sur le header. Easing
     lent et doux, liens qui apparaissent un à un. Les transitions sont
     neutralisées globalement pour prefers-reduced-motion (global.css). */
  .menu-bars {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.3s ease;
  }
  .menu-bars span:nth-child(1) { top: 0; }
  .menu-bars span:nth-child(2) { top: 6px; }
  .menu-bars span:nth-child(3) { top: 12px; }
  header[data-menu-open] .menu-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  header[data-menu-open] .menu-bars span:nth-child(2) { opacity: 0; transform: scaleX(0.3); }
  header[data-menu-open] .menu-bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .menu-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - 77px);
    overflow-y: auto;
    background: #fffdf7;
    border-radius: 0 0 1.5rem 1.5rem;
    box-shadow: 0 24px 40px -24px rgb(116 68 49 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition:
      opacity 0.45s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.6s;
  }
  header[data-menu-open] .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  header[data-menu-open] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 60ms);
  }

  .menu-backdrop {
    position: fixed;
    inset: 77px 0 0;
    z-index: -1;
    background: rgb(116 68 49 / 0.18);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s linear 0.5s;
  }
  header[data-menu-open] .menu-backdrop {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const panel = header?.querySelector<HTMLElement>("#menu-mobile");

  if (header && toggle && panel) {
    const desktop = window.matchMedia("(min-width: 1024px)");

    function setOpen(open: boolean) {
      header!.toggleAttribute("data-menu-open", open);
      // inert : liens du panneau fermé ni cliquables ni atteignables au clavier,
      // indépendamment de la fin de l'animation.
      panel!.inert = !open;
      toggle!.setAttribute("aria-expanded", String(open));
      toggle!.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
      document.documentElement.style.overflow = open ? "hidden" : "";
    }

    toggle.addEventListener("click", () => setOpen(!header.hasAttribute("data-menu-open")));
    header.querySelector(".menu-backdrop")?.addEventListener("click", () => setOpen(false));
    header.querySelectorAll("#menu-mobile a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-menu-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    desktop.addEventListener("change", (event) => event.matches && setOpen(false));
  }
</script>
