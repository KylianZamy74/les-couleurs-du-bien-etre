---
// Bloc principal d'une page de soin : photo encadrée sur texture, titre,
// accroche, texte (slot), tarifs et bouton de contact. Le titre est un h1 sur
// les pages de soin, un h2 quand la page a déjà un hero (accompagnement).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export type Price = { label: string; duration: string; price: string };

interface Props {
  title: string;
  headingLevel?: "h1" | "h2";
  tagline: string;
  prices: Price[];
  bgImage: ImageMetadata;
  photo: ImageMetadata;
  photoAlt: string;
}

const { title, headingLevel = "h1", tagline, prices, bgImage, photo, photoAlt } = Astro.props;
const Heading = headingLevel;
---

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl gap-16 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,440px)_1fr] lg:items-center lg:gap-24">
    <div class="reveal relative mx-auto w-full max-w-md" style="aspect-ratio: 420 / 399;">
      <Image
        src={bgImage}
        alt=""
        width={420}
        height={399}
        class="absolute bottom-0 left-0 h-full w-full object-cover"
        aria-hidden="true"
        priority
      />
      <Image
        src={photo}
        alt={photoAlt}
        width={340}
        height={230}
        class="absolute top-[10%] -right-[14%] z-0 h-[52%] w-[76%] object-cover"
        priority
      />
      <div
        class="pointer-events-none absolute top-[10%] -right-[14%] z-10 h-[52%] w-[76%] -translate-x-3 -translate-y-3 border-[3px] border-primary"
        aria-hidden="true"
      >
      </div>
    </div>
    <div class="reveal flex flex-col gap-5">
      <Heading class="font-display text-5xl font-bold text-primary sm:text-6xl">{title}</Heading>
      <p class="font-body text-base font-bold text-heading">{tagline}</p>
      <slot />
      <dl class="flex w-fit divide-x divide-primary/30 rounded-xl border border-primary/40 bg-bg-cream shadow-[0_6px_16px_-12px_rgba(0,0,0,0.4)]">
        {prices.map(({ label, duration, price }) => (
          <div class="flex flex-col items-center gap-1 px-6 py-3 text-center">
            <dt class="font-body text-[11px] font-extrabold tracking-widest text-primary uppercase">{label}</dt>
            <dd class="font-body text-lg font-extrabold text-heading">
              {duration} <span class="text-primary" aria-hidden="true">·</span> {price}
            </dd>
          </div>
        ))}
      </dl>
      <a
        href="/contact"
        class="font-body inline-flex w-fit items-center rounded-full bg-primary px-7 py-3.5 text-sm font-bold tracking-wide text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
      >
        Me contacter
      </a>
    </div>
  </div>
</section>
