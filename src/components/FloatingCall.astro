---
// Bouton flottant « Appeler » (mobile et tablette) : apparaît en fondu une
// fois le haut de page passé, masqué quand le menu burger est ouvert.
import { SITE } from "../data/site";
---

<a
  href={`tel:${SITE.phoneIntl}`}
  class="floating-call fixed right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white shadow-[0_10px_24px_-8px_rgb(116_68_49/0.6)] transition-transform active:scale-95 lg:hidden"
  aria-label={`Appeler Sarah au ${SITE.phone}`}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"></path>
  </svg>
</a>

<style>
  .floating-call {
    bottom: calc(1rem + env(safe-area-inset-bottom));
    opacity: 0;
    visibility: hidden;
    translate: 0 12px;
    transition:
      opacity 0.6s ease,
      translate 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.7s;
  }
  .floating-call.is-shown {
    opacity: 1;
    visibility: visible;
    translate: none;
    transition-delay: 0s;
  }
  :global(body:has(header[data-menu-open])) .floating-call {
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  // classList.toggle est trivial : pas besoin de throttle par rAF.
  const button = document.querySelector<HTMLElement>(".floating-call");
  if (button) {
    const update = () => button.classList.toggle("is-shown", window.scrollY > 320);
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
