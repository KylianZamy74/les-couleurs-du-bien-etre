---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  description: string;
  meta: string;
  image: ImageMetadata;
  delay?: number;
}

const { href, title, description, meta, image, delay = 0 } = Astro.props;

// Never request an upscale: some source photos are smaller than the card's
// display size, which makes Astro's image service error out. Cap the
// requested width at the source's native width and keep its aspect ratio;
// the aspect-[4/3] + object-cover wrapper handles the visual crop.
const targetWidth = Math.min(image.width, 480);
const targetHeight = Math.round(targetWidth * (image.height / image.width));
---

<a
  href={href}
  class="reveal group flex flex-col overflow-hidden rounded-2xl bg-card-bg shadow-[0_8px_24px_-16px_rgba(0,0,0,0.5)] transition-transform duration-300 hover:-translate-y-1"
  style={delay ? `transition-delay: ${delay}ms` : undefined}
>
  <div class="aspect-[4/3] overflow-hidden">
    <Image
      src={image}
      alt=""
      width={targetWidth}
      height={targetHeight}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="font-display text-3xl font-bold tracking-wide text-heading">{title}</h3>
    <p class="font-body flex-1 text-sm leading-relaxed text-text">{description}</p>
    <span class="font-body text-xs font-extrabold tracking-wide text-primary uppercase">{meta}</span>
    <span
      class="font-body mt-1 inline-flex w-fit items-center gap-1 rounded-md border border-border-soft bg-bg-gray px-3.5 py-2 text-[11px] font-extrabold tracking-wider text-btn-text uppercase transition-colors group-hover:bg-primary group-hover:text-white"
    >
      En savoir plus
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
