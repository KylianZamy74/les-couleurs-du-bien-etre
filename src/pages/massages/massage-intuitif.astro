---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/Faq.astro";
import { Image } from "astro:assets";
import { breadcrumbSchema, serviceSchema, faqSchema } from "../../data/schema";

import bgTexture from "../../assets/images/ombre-fleur-branche-zen.webp";
import portrait from "../../assets/images/sarah-vidal-massage-mains.webp";
import imgHuiles from "../../assets/images/huile-essentielle-flacon-compte-gouttes.webp";
import lotusIcon from "../../assets/icons/icone-lotus-couleurs-bien-etre.svg";

const faqItems = [
  {
    question: "Qu'est-ce qui rend le massage intuitif différent d'un massage classique ?",
    answer:
      "Un massage classique suit un protocole identique pour tout le monde. Ici, rien n'est décidé à l'avance : le déroulé s'ajuste à ce que vous ressentez pendant la séance.",
  },
  {
    question: "Quelles huiles essentielles sont utilisées pendant la séance ?",
    answer:
      "Elles sont choisies au cas par cas, selon ce dont votre corps a besoin ce jour-là.",
  },
  {
    question: "Combien de temps dure la séance et quel est le tarif ?",
    answer: "La séance dure 60 minutes, pour 75 €.",
  },
  {
    question: "Le massage intuitif convient-il pour une première séance de massage bien-être ?",
    answer:
      "Oui, tout à fait. N'hésitez pas à me parler de vos appréhensions ou de votre sensibilité lors de la prise de rendez-vous, j'en tiendrai compte pendant la séance.",
  },
  {
    question: "Comment réserver une séance ?",
    answer:
      "Le plus simple est de me contacter directement via le formulaire de contact du site : je reviens vers vous pour convenir ensemble d'un créneau adapté à vos disponibilités.",
  },
  {
    question: "Massage intuitif ou massage aux pierres chaudes, lequel choisir ?",
    answer:
      "Le massage intuitif (60 minutes, 75 €) s'adapte entièrement à vos besoins du jour, sans protocole fixe. Le massage aux pierres chaudes (75 minutes, 90 €) est plus enveloppant, avec un relâchement musculaire profond.",
  },
];
---

<BaseLayout
  title="Massage Intuitif | Les Couleurs du Bien-être | Villaz"
  description="Massage intuitif sur mesure aux huiles essentielles avec Sarah Vidal à Villaz (Haute-Savoie) : détente, bien-être et reconnexion à soi."
  path="/massages/massage-intuitif"
  jsonLd={[
    breadcrumbSchema([
      { name: "Accueil", path: "/" },
      { name: "Massages", path: "/massages" },
      { name: "Massage Intuitif", path: "/massages/massage-intuitif" },
    ]),
    serviceSchema({
      name: "Massage intuitif",
      description:
        "Massage totalement sur mesure aux huiles essentielles, adapté à l'état physique de la personne, ses ressentis, ses besoins du moment et ses points de tension.",
      path: "/massages/massage-intuitif",
    }),
    faqSchema(faqItems),
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-primary">
    <div class="font-body mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 text-xs font-bold tracking-widest text-white uppercase sm:px-6">
      <a href="/massages" class="hover:underline">Massages</a>
      <span aria-hidden="true">›</span>
      <span>Massage Intuitif</span>
    </div>
  </div>

  <!-- Main -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-16 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,440px)_1fr] lg:items-center lg:gap-24">
      <div class="reveal relative mx-auto w-full max-w-md" style="aspect-ratio: 420 / 399;">
        <Image
          src={bgTexture}
          alt=""
          width={420}
          height={399}
          class="absolute bottom-0 left-0 h-full w-full object-cover"
          aria-hidden="true"
          priority
        />
        <Image
          src={portrait}
          alt="Sarah Vidal pratiquant un massage bien-être"
          width={340}
          height={230}
          class="absolute top-[10%] -right-[14%] z-0 h-[52%] w-[76%] object-cover"
          priority
        />
        <div
          class="pointer-events-none absolute top-[10%] -right-[14%] z-10 h-[52%] w-[76%] -translate-x-3 -translate-y-3 border-[3px] border-primary"
          aria-hidden="true"
        >
        </div>
      </div>
      <div class="reveal flex flex-col gap-5">
        <h1 class="font-display text-5xl font-bold text-primary sm:text-6xl">Massage Intuitif</h1>
        <p class="font-body text-base font-bold text-heading">
          Partez à la rencontre de votre corps et de vos sensations
        </p>
        <p class="font-body text-base leading-relaxed text-text">
          Le massage intuitif est un massage totalement sur mesure. Le but de ce massage est de s'adapter
          à l'état physique de la personne, ses ressentis, ses besoins du moment, à ses points de tension.
        </p>
        <p class="font-body text-lg text-primary italic">
          « Le massage intuitif permet de remettre en lien le corps et l'esprit. »
        </p>
        <p class="font-body text-base font-bold text-heading">La séance dure 60 minutes, 75 €.</p>
        <a
          href="/contact"
          class="font-body inline-flex w-fit items-center rounded-full bg-primary px-7 py-3.5 text-sm font-bold tracking-wide text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
        >
          Me contacter
        </a>
      </div>
    </div>
  </section>

  <!-- Huiles essentielles -->
  <section class="bg-bg-cream">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-start px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-0">
      <div class="reveal relative z-10 flex flex-col gap-4 bg-white p-8 shadow-[0_10px_20px_-10px_rgba(0,0,0,0.3)] sm:p-10 sm:pr-16">
        <div class="flex items-center gap-3">
          <Image src={lotusIcon} alt="" width={64} height={64} class="h-16 w-16" />
          <h2 class="font-display text-4xl font-bold text-primary sm:text-5xl">Les huiles essentielles</h2>
        </div>
        <p class="font-body text-base leading-relaxed text-text">
          Les huiles essentielles sont obtenues par distillation à la vapeur d'eau de plantes aromatiques.
          Elles sont des extraits naturels de plantes puissantes et d'une extraordinaire efficacité, tant
          sur le plan de la santé que de la beauté et du bien-être. Celles-ci sont utilisées depuis des
          siècles pour se soigner.
        </p>
      </div>
      <div class="reveal relative z-20 mx-auto w-full max-w-[480px] lg:-ml-8" style="aspect-ratio: 470/338">
        <Image
          src={imgHuiles}
          alt="Flacon compte-gouttes d'huile essentielle"
          width={470}
          height={338}
          class="absolute inset-0 z-0 h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute -top-5 -left-5 z-10 h-full w-full border-[3px] border-primary" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- Pour qui -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="font-body mb-2 text-sm font-extrabold tracking-widest text-primary uppercase">
        Le massage intuitif, en bref
      </p>
      <h2 class="font-display mb-5 text-4xl font-bold text-heading sm:text-5xl">
        Pour qui est fait le massage intuitif ?
      </h2>
      <p class="font-body text-base leading-relaxed text-text">
        Il n'y a pas vraiment de profil type. C'est un bon point de départ si vous découvrez le massage
        bien-être, puisque la séance s'adapte à vous plutôt que l'inverse. Et c'est aussi un bon choix si
        vous êtes déjà habitué, mais que vos attentes changent d'une fois à l'autre.
      </p>
      <p class="font-body mt-5 text-base leading-relaxed text-text">
        Certaines personnes viennent pour dénouer des tensions accumulées, d'autres simplement pour se
        déconnecter un moment, ou au contraire pour se reconnecter à elles-mêmes. C'est tout l'intérêt d'un
        massage qui ne suit pas de protocole : il part de là où vous en êtes ce jour-là.
      </p>
    </div>
  </section>

  <!-- Ancrage local -->
  <section class="bg-white">
    <div class="reveal mx-auto max-w-3xl border-t border-border-soft px-4 pt-14 pb-4 text-center sm:px-6">
      <h2 class="font-display mb-5 text-4xl font-bold text-heading sm:text-5xl">
        Un massage bien-être à Villaz, au-dessus d'Annecy
      </h2>
      <p class="font-body text-base leading-relaxed text-text">
        Les séances se déroulent à Villaz, en Haute-Savoie, sur les hauteurs d'Annecy — un cadre au calme,
        le temps d'une parenthèse rien que pour vous.
      </p>
    </div>
  </section>

  <p class="font-body mx-auto max-w-3xl px-4 pb-12 text-center text-xs leading-relaxed text-heading/60 sm:px-6">
    Ce massage est à visée de détente, de bien-être et de relaxation, non thérapeutique —
    <a href="/conditions-generales-de-vente" class="underline hover:text-primary">conditions générales de vente</a>.
  </p>

  <!-- FAQ -->
  <section class="bg-bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="reveal mb-10 flex flex-col items-center gap-2 text-center sm:mb-14">
        <p class="font-body text-sm font-extrabold tracking-widest text-primary uppercase">Questions fréquentes</p>
        <h2 class="font-display text-4xl font-bold text-heading sm:text-5xl">Avant de prendre rendez-vous</h2>
      </div>
      <Faq items={faqItems} />
    </div>
  </section>

  <!-- Maillage interne -->
  <section class="bg-white">
    <div class="reveal mx-auto flex max-w-3xl flex-col items-center gap-4 px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="font-body text-sm leading-relaxed text-text">
        Vous hésitez avec un autre soin ?
        <a href="/massages/massage-pierres-chaudes" class="font-bold text-primary hover:underline">
          Découvrez le massage aux pierres chaudes
        </a>
        ou <a href="/massages" class="font-bold text-primary hover:underline">retrouvez tous les massages</a>.
      </p>
    </div>
  </section>
</BaseLayout>
