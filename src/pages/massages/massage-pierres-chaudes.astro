---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/Faq.astro";
import { Image } from "astro:assets";
import { breadcrumbSchema, serviceSchema, faqSchema } from "../../data/schema";

import bgTexture from "../../assets/images/ombre-fleur-branche-zen.webp";
import imgSeance from "../../assets/images/massage-pierres-chaudes-seance.webp";
import imgPierres from "../../assets/images/massage-pierres-chaudes-pose-galets.webp";
import lotusIcon from "../../assets/icons/icone-lotus-couleurs-bien-etre.svg";

const faqItems = [
  {
    question: "Quels sont les bienfaits du massage aux pierres chaudes ?",
    answer:
      "L'action des pierres chaudes sur la peau apporte un relâchement musculaire profond et un sentiment d'apaisement. C'est un massage drainant et détoxifiant qui améliore la circulation sanguine.",
  },
  {
    question: "Quelles pierres sont utilisées pendant le massage ?",
    answer:
      "Des pierres volcaniques en basalte naturel, héritage des terres d'Hawaï. Nées de la chaleur extrême du magma terrestre puis refroidies brutalement par l'eau de la mer, elles ont la particularité de stocker puis de libérer la chaleur.",
  },
  {
    question: "Combien de temps dure la séance et quel est le tarif ?",
    answer:
      "La séance dure 75 minutes, pour 90 €. Elle est un peu plus longue qu'un massage intuitif, la mise en place et le retrait des pierres demandant un peu plus de temps.",
  },
  {
    question: "Quelle différence avec le massage intuitif ?",
    answer:
      "Le massage intuitif est un massage totalement sur mesure aux huiles essentielles, adapté à vos ressentis et à vos points de tension du moment. Le massage aux pierres chaudes ajoute la chaleur des pierres volcaniques, pour un relâchement musculaire plus profond et enveloppant.",
  },
  {
    question: "Le massage aux pierres chaudes convient-il à tout le monde ?",
    answer:
      "Si vous avez une condition médicale particulière ou un doute, parlez-m'en lors de la prise de rendez-vous : nous choisirons ensemble le massage le plus adapté à votre situation, éventuellement le massage intuitif à la place.",
  },
  {
    question: "Comment réserver une séance ?",
    answer:
      "Le plus simple est de me contacter directement via le formulaire de contact du site : je reviens vers vous pour convenir ensemble d'un créneau adapté à vos disponibilités.",
  },
];
---

<BaseLayout
  title="Massage pierres chaudes à Villaz | Couleurs du Bien-être"
  description="Massage aux pierres chaudes volcaniques à Villaz, près d'Annecy : relâchement musculaire profond. Séance de 75 min, 90 €. Réservez avec Sarah Vidal."
  path="/massages/massage-pierres-chaudes"
  jsonLd={[
    breadcrumbSchema([
      { name: "Accueil", path: "/" },
      { name: "Massages", path: "/massages" },
      { name: "Massage aux pierres chaudes", path: "/massages/massage-pierres-chaudes" },
    ]),
    serviceSchema({
      name: "Massage aux pierres chaudes",
      description:
        "Massage enveloppant aux pierres volcaniques chaudes : l'action des pierres chaudes sur la peau apporte un relâchement musculaire profond et améliore la circulation sanguine.",
      path: "/massages/massage-pierres-chaudes",
    }),
    faqSchema(faqItems),
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-primary">
    <div class="font-body mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 text-xs font-bold tracking-widest text-white uppercase sm:px-6">
      <a href="/massages" class="hover:underline">Massages</a>
      <span aria-hidden="true">›</span>
      <span>Massage aux pierres chaudes</span>
    </div>
  </div>

  <!-- Main -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-16 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,440px)_1fr] lg:items-center lg:gap-24">
      <div class="reveal relative mx-auto w-full max-w-md" style="aspect-ratio: 420 / 399;">
        <Image
          src={bgTexture}
          alt=""
          width={420}
          height={399}
          class="absolute bottom-0 left-0 h-full w-full object-cover"
          aria-hidden="true"
          priority
        />
        <Image
          src={imgSeance}
          alt="Sarah Vidal pratiquant un massage aux pierres chaudes sur le dos à Villaz"
          width={340}
          height={230}
          class="absolute top-[10%] -right-[14%] z-0 h-[52%] w-[76%] object-cover"
          priority
        />
        <div
          class="pointer-events-none absolute top-[10%] -right-[14%] z-10 h-[52%] w-[76%] -translate-x-3 -translate-y-3 border-[3px] border-primary"
          aria-hidden="true"
        >
        </div>
      </div>
      <div class="reveal flex flex-col gap-5">
        <h1 class="font-display text-5xl font-bold text-primary sm:text-6xl">Massage aux pierres chaudes</h1>
        <p class="font-body text-base font-bold text-heading">Une rencontre privilégiée entre massage et chaleur</p>
        <p class="font-body text-base leading-relaxed text-text">
          D'une douceur infinie, ces pierres accumulent la chaleur pour des effets incroyables sur le corps.
        </p>
        <p class="font-body text-base leading-relaxed text-text">
          L'action des pierres chaudes sur la peau apporte un relâchement musculaire profond et un sentiment
          d'apaisement. C'est un massage drainant et détoxifiant qui améliore la circulation sanguine.
        </p>
        <p class="font-body text-base font-bold text-heading">Séance de 75 minutes, 90 €.</p>
        <a
          href="/contact"
          class="font-body inline-flex w-fit items-center rounded-full bg-primary px-7 py-3.5 text-sm font-bold tracking-wide text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
        >
          Me contacter
        </a>
      </div>
    </div>
  </section>

  <!-- Les pierres chaudes -->
  <section class="bg-bg-cream">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-start px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-0">
      <div class="reveal relative z-10 flex flex-col gap-4 bg-white p-8 shadow-[0_10px_20px_-10px_rgba(0,0,0,0.3)] sm:p-10 sm:pr-16">
        <div class="flex items-center gap-3">
          <Image src={lotusIcon} alt="" width={64} height={64} class="h-16 w-16" />
          <h2 class="font-display text-4xl font-bold text-primary sm:text-5xl">Les pierres chaudes</h2>
        </div>
        <p class="font-body text-base leading-relaxed text-text">
          Héritage des terres d'Hawaï, les pierres volcaniques possèdent la particularité de pouvoir stocker
          et libérer la chaleur.
        </p>
        <p class="font-body text-base leading-relaxed text-text">
          Composées de pierre de basalte naturel, elles sont nées de la chaleur extrême du magma terrestre,
          puis du refroidissement brutal par l'eau de la mer.
        </p>
      </div>
      <div class="reveal relative z-20 mx-auto w-full max-w-[480px] lg:-ml-8" style="aspect-ratio: 470/338">
        <Image
          src={imgPierres}
          alt="Pose de pierres volcaniques chaudes sur le dos pendant un massage"
          width={470}
          height={338}
          class="absolute inset-0 z-0 h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute -top-5 -left-5 z-10 h-full w-full border-[3px] border-primary" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- Pour qui / déroulé -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="font-body mb-2 text-sm font-extrabold tracking-widest text-primary uppercase">
        Le massage aux pierres chaudes, en bref
      </p>
      <h2 class="font-display mb-5 text-4xl font-bold text-heading sm:text-5xl">
        Pour qui est fait le massage aux pierres chaudes ?
      </h2>
      <p class="font-body text-base leading-relaxed text-text">
        Le massage aux pierres chaudes s'adresse à toute personne qui a besoin de relâcher en profondeur
        ses tensions musculaires : la chaleur des pierres enveloppe le corps et aide les muscles à se
        détendre plus facilement qu'avec les mains seules. C'est un massage idéal pour s'offrir une vraie
        pause, se réchauffer et retrouver un sentiment d'apaisement.
      </p>
      <h3 class="font-display mt-10 mb-4 text-3xl font-bold text-heading">Comment se déroule la séance ?</h3>
      <p class="font-body text-base leading-relaxed text-text">
        La séance commence par un temps d'échange pour comprendre vos besoins du moment et vos zones de
        tension. Les pierres chaudes sont ensuite déposées sur le corps et utilisées pour masser, en
        alternance avec les mains. Comptez 75 minutes : la mise en place et le retrait des pierres demandent
        un peu plus de temps qu'un massage classique. Les séances ont lieu à Villaz, à quelques minutes
        d'Annecy.
      </p>
    </div>
  </section>

  <p class="font-body mx-auto max-w-3xl px-4 pb-12 text-center text-xs leading-relaxed text-heading/60 sm:px-6">
    Ce massage est à visée de détente, de bien-être et de relaxation, non thérapeutique —
    <a href="/conditions-generales-de-vente" class="underline hover:text-primary">conditions générales de vente</a>.
  </p>

  <!-- FAQ -->
  <section class="bg-bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="reveal mb-10 flex flex-col items-center gap-2 text-center sm:mb-14">
        <p class="font-body text-sm font-extrabold tracking-widest text-primary uppercase">Questions fréquentes</p>
        <h2 class="font-display text-4xl font-bold text-heading sm:text-5xl">Avant de prendre rendez-vous</h2>
      </div>
      <Faq items={faqItems} />
    </div>
  </section>

  <!-- Maillage interne -->
  <section class="bg-white">
    <div class="reveal mx-auto flex max-w-3xl flex-col items-center gap-4 px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="font-body text-sm leading-relaxed text-text">
        Vous hésitez avec un autre soin ?
        <a href="/massages/massage-intuitif" class="font-bold text-primary hover:underline">
          Découvrez le massage intuitif
        </a>
        ou <a href="/massages" class="font-bold text-primary hover:underline">retrouvez tous les massages</a>.
      </p>
    </div>
  </section>
</BaseLayout>
