---
// Gabarit commun des pages de soin (massages, soins énergétiques) : fil
// d'Ariane, bloc principal, section détail, contenus propres à la page (slot
// "extra"), mention non thérapeutique, FAQ et maillage interne. Metas et
// JSON-LD sont dérivés des mêmes props, pour rester alignés avec le contenu.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Faq from "../components/Faq.astro";
import { breadcrumbSchema, serviceSchema, faqSchema } from "../data/schema";
import lotusIcon from "../assets/icons/icone-lotus-couleurs-bien-etre.svg";

interface Props {
  title: string;
  description: string;
  path: string;
  name: string;
  serviceDescription: string;
  category: { name: string; path: string; all: string };
  tagline: string;
  price: string;
  bgImage: ImageMetadata;
  photo: ImageMetadata;
  photoAlt: string;
  detailTitle: string;
  detailImage: ImageMetadata;
  detailImageAlt: string;
  disclaimer: string;
  faqItems: { question: string; answer: string }[];
  related: { label: string; href: string };
}

const {
  title,
  description,
  path,
  name,
  serviceDescription,
  category,
  tagline,
  price,
  bgImage,
  photo,
  photoAlt,
  detailTitle,
  detailImage,
  detailImageAlt,
  disclaimer,
  faqItems,
  related,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={[
    breadcrumbSchema([
      { name: "Accueil", path: "/" },
      { name: category.name, path: category.path },
      { name, path },
    ]),
    serviceSchema({ name, description: serviceDescription, path }),
    faqSchema(faqItems),
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-primary">
    <div class="font-body mx-auto flex max-w-6xl items-center gap-2 px-4 py-4 text-xs font-bold tracking-widest text-white uppercase sm:px-6">
      <a href={category.path} class="hover:underline">{category.name}</a>
      <span aria-hidden="true">›</span>
      <span>{name}</span>
    </div>
  </div>

  <!-- Main -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-16 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,440px)_1fr] lg:items-center lg:gap-24">
      <div class="reveal relative mx-auto w-full max-w-md" style="aspect-ratio: 420 / 399;">
        <Image
          src={bgImage}
          alt=""
          width={420}
          height={399}
          class="absolute bottom-0 left-0 h-full w-full object-cover"
          aria-hidden="true"
          priority
        />
        <Image
          src={photo}
          alt={photoAlt}
          width={340}
          height={230}
          class="absolute top-[10%] -right-[14%] z-0 h-[52%] w-[76%] object-cover"
          priority
        />
        <div
          class="pointer-events-none absolute top-[10%] -right-[14%] z-10 h-[52%] w-[76%] -translate-x-3 -translate-y-3 border-[3px] border-primary"
          aria-hidden="true"
        >
        </div>
      </div>
      <div class="reveal flex flex-col gap-5">
        <h1 class="font-display text-5xl font-bold text-primary sm:text-6xl">{name}</h1>
        <p class="font-body text-base font-bold text-heading">{tagline}</p>
        <slot />
        <p class="font-body text-base font-bold text-heading">{price}</p>
        <a
          href="/contact"
          class="font-body inline-flex w-fit items-center rounded-full bg-primary px-7 py-3.5 text-sm font-bold tracking-wide text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
        >
          Me contacter
        </a>
      </div>
    </div>
  </section>

  <!-- Détail -->
  <section class="bg-bg-cream">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-start px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-0">
      <div class="reveal relative z-10 flex flex-col gap-4 bg-white p-8 shadow-[0_10px_20px_-10px_rgba(0,0,0,0.3)] sm:p-10 sm:pr-16">
        <div class="flex items-center gap-3">
          <Image src={lotusIcon} alt="" width={64} height={64} class="h-16 w-16" />
          <h2 class="font-display text-4xl font-bold text-primary sm:text-5xl">{detailTitle}</h2>
        </div>
        <slot name="detail" />
      </div>
      <div class="reveal relative z-20 mx-auto w-full max-w-[480px] lg:-ml-8" style="aspect-ratio: 470/338">
        <Image
          src={detailImage}
          alt={detailImageAlt}
          width={470}
          height={338}
          class="absolute inset-0 z-0 h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute -top-5 -left-5 z-10 h-full w-full border-[3px] border-primary" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <slot name="extra" />

  <p class="font-body mx-auto max-w-3xl px-4 pb-12 text-center text-xs leading-relaxed text-heading/60 sm:px-6">
    {disclaimer} —
    <a href="/conditions-generales-de-vente" class="underline hover:text-primary">conditions générales de vente</a>.
  </p>

  <!-- FAQ -->
  <section class="bg-bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="reveal mb-10 flex flex-col items-center gap-2 text-center sm:mb-14">
        <p class="font-body text-sm font-extrabold tracking-widest text-primary uppercase">Questions fréquentes</p>
        <h2 class="font-display text-4xl font-bold text-heading sm:text-5xl">Avant de prendre rendez-vous</h2>
      </div>
      <Faq items={faqItems} />
    </div>
  </section>

  <!-- Maillage interne -->
  <section class="bg-white">
    <div class="reveal mx-auto flex max-w-3xl flex-col items-center gap-4 px-4 py-16 text-center sm:px-6 sm:py-20">
      <p class="font-body text-sm leading-relaxed text-text">
        Vous hésitez avec un autre soin ?
        <a href={related.href} class="font-bold text-primary hover:underline">Découvrez {related.label}</a>
        ou <a href={category.path} class="font-bold text-primary hover:underline">retrouvez {category.all}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
